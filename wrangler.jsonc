{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "dad98f75-9e4c-4b4a-95f5-d44e064b3eaf","database_name": "web-app-2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0da5a15c7c91450798c6cb9edc0d861b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
